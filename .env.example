# ==========================================
# QuizMaster Environment Variables Template
# ==========================================

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------
# Clerk Authentication Configuration
# ------------------------------------------
# Obtain from: Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ------------------------------------------
# Optional Backend / Edge Function Keys
# ------------------------------------------
# Used when deploying Supabase Edge Functions (e.g., Clerk webhook sync)
# CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
